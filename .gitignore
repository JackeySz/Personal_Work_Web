# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/

# removed starter leftovers
/app/
/build/
/db/
/drizzle/
/examples/
/public/
/worker/
